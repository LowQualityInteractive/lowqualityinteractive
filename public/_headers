# Force the .md endpoints to serve as markdown even on hosts that infer
# Content-Type from extension. Without this some CDNs send `application/
# octet-stream` for `.md`, which causes browsers to download instead of
# render and confuses LLM clients that filter by Content-Type.
/*.md
  Content-Type: text/markdown; charset=utf-8
  Vary: Accept
