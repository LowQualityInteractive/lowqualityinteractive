# force .md to be served as text/markdown
# without this some cdns send application/octet-stream and browsers download
# instead of rendering, plus llm clients that filter on Content-Type drop us
/*.md
  Content-Type: text/markdown; charset=utf-8

# cache-control. astro emits hashed filenames under /_astro/ so those are
# safe to mark immutable for a year - they're content-addressed, the url
# changes on every content change. html and other top-level files use a
# HTML must revalidate after the short fresh window. Astro asset filenames are
# content-hashed, so stale HTML can otherwise point at assets removed by a new
# atomic deployment and render an unstyled page.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# self-hosted woff2 - long-lived. filenames are stable, so on the rare
# font change rename the file (or append a ?v=) to bust caches.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
