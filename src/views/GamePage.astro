---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getGameBySlug,
  getGameAboutPath,
  getGameJsonLd,
  getGameUpdateHref,
} from '../data/games';
import { getSiteTitle, toAbsoluteSiteUrl } from '../data/site';
import { getLocalePath, getMessages, interpolate, type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const messages = getMessages(locale);
const page = messages.pages.game;
const statusLabels = messages.chrome.status;
const game = getGameBySlug(locale, slug);

if (!game) {
  throw new Error(`Unknown game slug: ${slug}`);
}

const statusLabel = statusLabels[game.status as keyof typeof statusLabels] ?? game.status;
const aboutLabels = page.about ?? {
  developer: 'Developer',
  platform: 'Platform',
  genre: 'Genre',
  status: 'Status',
};
---

<BaseLayout
  locale={locale}
  title={getSiteTitle(game.name)}
  description={game.pageDescription}
  currentPage="games"
  routePath={game.slug}
  jsonLd={getGameJsonLd(locale, game)}
  ogImage={game.artwork.src}
  ogImageAlt={game.artwork.alt}
>
  <link slot="head-extra" rel="about" href={toAbsoluteSiteUrl(getGameAboutPath(locale, game))} />
  <section class="hero">
    <span class="kicker hero-enter" style="--enter-delay: 40ms">{page.kicker}</span>
    <h1 class="hero-enter" style="--enter-delay: 120ms">{game.name}</h1>
    <p class="lead hero-enter" style="--enter-delay: 220ms">{game.pageLead}</p>
    <div class="cta-row hero-enter" style="--enter-delay: 300ms">
      {/* the visible label is just "play". the aria-label spells out
          the game + platform so screen readers know which "play" this is. */}
      <a class="button primary button-play" target="_blank" rel="noopener noreferrer" href={game.robloxUrl} aria-label={interpolate(page.openGameOn, { game: game.name })}>
        <span>{page.openGame}</span>
        <svg class="btn-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" width="14" height="14">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a class="button ghost" href={getGameUpdateHref(locale, game)}>
        <span>{page.latestUpdate}</span>
        <svg class="btn-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" width="14" height="14">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a class="button ghost" href={getLocalePath(locale, 'games')}>
        <span>{page.backToGames}</span>
      </a>
    </div>
  </section>

  <section class="game-presence" data-reveal data-game-id={game.id} aria-label={`${game.name} at a glance`}>
    <div class="game-presence-art">
      {game.status === 'live' && (
        <span class="game-presence-tag" aria-hidden="true">
          <span class="game-presence-tag-dot"></span>
          <span>{statusLabel}</span>
        </span>
      )}
      <img
        src={game.artwork.src}
        alt={game.artwork.alt}
        width={game.artwork.width}
        height={game.artwork.height}
        loading="eager"
      />
    </div>
    <aside class="game-presence-meta">
      <dl class="game-presence-meta-grid">
        <div>
          <dt>{aboutLabels.platform}</dt>
          <dd>Roblox</dd>
        </div>
        <div>
          <dt>{aboutLabels.status}</dt>
          <dd><span class={game.status === 'live' ? 'accent' : ''}>{statusLabel}</span></dd>
        </div>
        <div>
          <dt>{aboutLabels.genre}</dt>
          <dd>{game.genreLabel}</dd>
        </div>
        <div>
          <dt>{aboutLabels.developer}</dt>
          <dd>LQI</dd>
        </div>
      </dl>
      {game.universeId && (
        <div class="game-presence-live">
          <span class="game-presence-live-label">Now playing</span>
          {/* live.ts targets [data-game-id] > .game-player-count and
              writes the localized "{n} playing" text into it. we render
              "—" up front to reserve the row so the layout doesn't jump
              when the data finally lands. */}
          <span class="game-presence-live-value game-player-count" data-translatable>—</span>
        </div>
      )}
    </aside>
  </section>
</BaseLayout>
