---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getGameBySlug,
  getGameAboutJsonLd,
  getGameHref,
  getGameUpdateHref,
} from '../data/games';
import { getSiteTitle, SITE_NAME, toAbsoluteSiteUrl } from '../data/site';
import { getMessages, sanitizeInlineScript, type Locale } from '../i18n/messages';
import { getAboutTranslateScript } from '../scripts/translate';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const messages = getMessages(locale);
const page = messages.pages.game;
const statusLabels = messages.chrome.status;
const game = getGameBySlug(locale, slug);

if (!game) {
  throw new Error(`Unknown game slug: ${slug}`);
}

const aboutRoutePath = `${game.slug}/about`;
const statusLabel = statusLabels[game.status as keyof typeof statusLabels] ?? game.status;
const aboutLabels = page.about ?? {
  kicker: 'About this game',
  developer: 'Developer',
  platform: 'Platform',
  genre: 'Genre',
  status: 'Status',
  featuresHeading: 'Features',
  linksHeading: 'Official links',
};

interface GameAboutData {
  body: string[];
  features: string[];
  media: { src: string; alt: string; caption?: string }[];
  links: { label: string; href: string; external: boolean }[];
}

const emptyAboutData: GameAboutData = { body: [], features: [], media: [], links: [] };

function isRecord(value: unknown): value is Record<string, unknown> {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

function stringValue(value: unknown) {
  return typeof value === 'string' ? value.trim() : '';
}

function stringArray(value: unknown) {
  return Array.isArray(value) ? value.map(stringValue).filter(Boolean) : [];
}

function normalizeAssetSrc(value: unknown) {
  const raw = stringValue(value);
  if (!raw || /^(?:[a-z][a-z\d+.-]*:|\/\/)/i.test(raw) || raw.includes('\\')) return '';
  const normalized = `/${raw.replace(/^\/+/, '')}`;
  return normalized.startsWith('/assets/') && !normalized.includes('..') ? normalized : '';
}

function normalizeInternalHref(value: unknown) {
  const raw = stringValue(value);
  if (!raw || !raw.startsWith('/') || raw.startsWith('//') || raw.includes('\\')) return '';
  return raw.includes('\0') ? '' : raw;
}

function normalizeExternalHref(value: unknown) {
  const raw = stringValue(value);
  if (!raw) return '';

  try {
    const url = new URL(raw);
    return url.protocol === 'https:' ? url.toString() : '';
  } catch {
    return '';
  }
}

function normalizeAboutData(value: unknown): GameAboutData {
  if (!isRecord(value)) return emptyAboutData;

  const media = Array.isArray(value.media)
    ? value.media.flatMap((item) => {
        if (!isRecord(item)) return [];
        const src = normalizeAssetSrc(item.src);
        const alt = stringValue(item.alt);
        if (!src || !alt) return [];
        const caption = stringValue(item.caption);
        return [{ src, alt, ...(caption ? { caption } : {}) }];
      })
    : [];

  const links = Array.isArray(value.links)
    ? value.links.flatMap((item) => {
        if (!isRecord(item)) return [];
        const label = stringValue(item.label);
        const external = item.external === true;
        const href = external ? normalizeExternalHref(item.href) : normalizeInternalHref(item.href);
        return label && href ? [{ label, href, external }] : [];
      })
    : [];

  return {
    body: stringArray(value.body),
    features: stringArray(value.features),
    media,
    links,
  };
}

let aboutData = emptyAboutData;

try {
  const raw = JSON.parse(readFileSync(resolve('public/data/game-about.json'), 'utf-8'));
  const entries = isRecord(raw) && Array.isArray(raw.games) ? raw.games : [];
  const entry = entries.find((item): item is Record<string, unknown> => isRecord(item) && item.id === game.id);
  if (entry) aboutData = normalizeAboutData(entry);
} catch {}

const aboutTranslateScript = sanitizeInlineScript(getAboutTranslateScript());
---

<BaseLayout
  locale={locale}
  title={getSiteTitle(`About ${game.name}`)}
  description={game.pageDescription}
  currentPage="games"
  routePath={aboutRoutePath}
  jsonLd={getGameAboutJsonLd(locale, game)}
  ogImage={game.artwork.src}
  extraScripts={[aboutTranslateScript]}
>
  <link slot="head-extra" rel="up" href={toAbsoluteSiteUrl(getGameHref(locale, game))} />

  <section class="hero">
    <span class="kicker">{aboutLabels.kicker}</span>
    <h1>{game.name}</h1>
    <p class="lead">{game.pageLead}</p>
    <div class="cta-row">
      <a class="button primary button-play" target="_blank" rel="noopener noreferrer" href={game.robloxUrl}>{page.openGame}</a>
      <a class="button ghost" href={getGameUpdateHref(locale, game)}>{page.latestUpdate}</a>
      <a class="button ghost" href={getGameHref(locale, game)}>{page.backToGames}</a>
    </div>
  </section>

  <section class="about-details">
    <dl class="about-grid">
      <div class="about-entry">
        <dt>{aboutLabels.developer}</dt>
        <dd>{SITE_NAME}</dd>
      </div>
      <div class="about-entry">
        <dt>{aboutLabels.platform}</dt>
        <dd>Roblox</dd>
      </div>
      <div class="about-entry">
        <dt>{aboutLabels.genre}</dt>
        <dd>{game.genreLabel}</dd>
      </div>
      <div class="about-entry">
        <dt>{aboutLabels.status}</dt>
        <dd>{statusLabel}</dd>
      </div>
    </dl>

    {aboutData.media.length > 0 && (
      <div class="about-media">
        {aboutData.media.map((item) => (
          <figure class="about-media-item">
            <img src={item.src} alt={item.alt} loading="lazy" />
            {item.caption && <figcaption data-translatable>{item.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )}

    {aboutData.body.length > 0 && (
      <div class="about-body" id="about-body">
        {aboutData.body.map((para) => (
          <p data-translatable>{para}</p>
        ))}
      </div>
    )}

    {aboutData.features.length > 0 && (
      <div class="about-features">
        <h2>{aboutLabels.featuresHeading}</h2>
        <ul id="about-features-list">
          {aboutData.features.map((feat) => (
            <li data-translatable>{feat}</li>
          ))}
        </ul>
      </div>
    )}

    {aboutData.links.length > 0 && (
      <div class="about-links">
        <h2>{aboutLabels.linksHeading}</h2>
        <ul>
          {aboutData.links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
                data-translatable
              >{link.label}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>
