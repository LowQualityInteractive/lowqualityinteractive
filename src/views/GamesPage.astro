---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getGameAboutPath,
  getGameHref,
  getGameUpdateHref,
  getGamesJsonLd,
  getPublishedGames,
  getWebpSrc,
} from '../data/games';
import { getSiteTitle } from '../data/site';
import { getInWorkProjects } from '../data/inWorks';
import { getMessages, interpolate, type Locale } from '../i18n/messages';
import { getWikiHubHref, hasWiki } from '../data/wiki';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const page = messages.pages.games;
const liveGames = getPublishedGames(locale);
// Keep these pipeline projects in the data, but hide them from the Games page
// until they are ready to return. Remove an id to restore it.
const HIDDEN_PIPELINE_PROJECT_IDS = new Set(['operation-five-siege', 'crowns-of-steel']);
const projects = getInWorkProjects(locale).filter((project) => !HIDDEN_PIPELINE_PROJECT_IDS.has(project.id));
const GAME_DISPLAY_ORDER: Record<string, number> = {
  eradication: 1,
  agmina: 2,
  'favela-94': 3,
  'donpollo-obby': 4,
};
---

<BaseLayout
  locale={locale}
  title={getSiteTitle('Games')}
  description={page.description}
  currentPage="games"
  routePath="games"
  jsonLd={getGamesJsonLd(locale)}
>
  <div class="core-page core-page--games">
  <section class="core-intro">
    <div>
      <h1 class="hero-enter" style="--enter-delay: 100ms">{page.heading}</h1>
    </div>
  </section>

  <section class="core-section" aria-label={page.liveGamesHeading}>
    <div class="game-ledger" aria-label={page.gameListAriaLabel}>
    {liveGames.map((game, i) => {
      const webpSrc = getWebpSrc(game.artwork.src);
      return (
      <article class="game-entry" data-game-id={game.id} data-reveal data-reveal-i={String(Math.min(i + 1, 6))} style={`order: ${GAME_DISPLAY_ORDER[game.id] ?? 99}`}>
        <div class="game-entry-image">
          <a href={getGameHref(locale, game)} aria-label={interpolate(page.viewGameDetails, { game: game.name })}>
            {/* webp sibling is generated at build time for every card
                artwork. browsers that don't support webp (~3% globally)
                fall through to the png. width/height are mandatory to
                reserve layout space and avoid CLS. */}
            <picture>
              {webpSrc && (
                <source type="image/webp" srcset={webpSrc} />
              )}
              <img
                src={game.artwork.src}
                alt={game.artwork.alt}
                width={game.artwork.width}
                height={game.artwork.height}
                loading="lazy"
                decoding="async"
                data-fade
              />
            </picture>
          </a>
        </div>
        <div class="game-entry-body">
          <span class="game-entry-genre">{game.genreLabel}</span>
          <h2>
            <a class="game-card-title-link" href={getGameHref(locale, game)}>{game.name}</a>
          </h2>
          <p>{game.description}</p>
          <span class="game-player-count" hidden></span>
        </div>
        <div class="game-entry-actions">
          <a class="game-entry-play" target="_blank" rel="noopener noreferrer" href={game.robloxUrl} aria-label={interpolate(page.playGameOn, { game: game.name })}>
            <span>{page.playGame}</span>
          </a>
          <div class="game-card-links">
            <a href={getGameUpdateHref(locale, game)}>{page.updates}</a>
            <a href={getGameAboutPath(locale, game)}>{page.about}</a>
            {hasWiki(game.slug) && (
              <a href={getWikiHubHref(locale, game.slug)}>Wiki</a>
            )}
          </div>
        </div>
      </article>
      );
    })}
    {projects.map((project, i) => (
      <article class="game-entry game-entry--pipeline" data-game-id={project.id} data-reveal data-reveal-i={String(Math.min(liveGames.length + i + 1, 6))} style={`order: ${GAME_DISPLAY_ORDER[project.id] ?? 99}`}>
        <div class="game-entry-image game-entry-image--pipeline">
          <span>{project.stageLabel}</span>
        </div>
        <div class="game-entry-body">
          <span class="game-entry-genre">{project.genre}</span>
          <h2>{project.name}</h2>
        </div>
        {project.robloxUrl && (
          <div class="game-entry-actions">
            <a class="game-entry-play" target="_blank" rel="noopener noreferrer" href={project.robloxUrl}>
              <span>{page.playGame}</span>
            </a>
          </div>
        )}
      </article>
    ))}
    </div>
  </section>
  </div>
</BaseLayout>
