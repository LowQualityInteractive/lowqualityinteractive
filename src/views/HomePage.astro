---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGameBySlug, getHomeJsonLd } from '../data/games';
import { getLocalePath, getMessages, type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const page = messages.pages.home;

// build-time fetch - happens on the server, so cors gets to sit this one out.
// timeout caps the build wait if roblox stalls; non-2xx and non-json responses
// are ignored so a hostile or broken upstream just shows '-' instead of a
// silent regression.
let latestUpdate: {
  game: string;
  id: string;
  version: string;
  date: string;
  summary: string;
  cover: string;
} | null = null;
try {
  const devlogsPath = resolve('public/data/public-devlogs.json');
  const devlogs = JSON.parse(readFileSync(devlogsPath, 'utf-8'));
  if (Array.isArray(devlogs.games)) {
    const latestGame = devlogs.games.find(
      (game: { id?: unknown; name?: unknown; updates?: unknown[] }) => typeof game.id === 'string' && typeof game.name === 'string' && Array.isArray(game.updates) && game.updates.length > 0,
    );
    const update = latestGame?.updates?.[0];
    if (
      update &&
      typeof update.id === 'string' &&
      typeof update.version === 'string' &&
      typeof update.date === 'string'
    ) {
      latestUpdate = {
        game: latestGame.name,
        id: update.id,
        version: update.version,
        date: update.date,
        cover: typeof latestGame.id === 'string'
          ? getGameBySlug(locale, latestGame.id)?.artwork.src ?? ''
          : '',
        summary: locale === 'en'
          ? 'This update adds RGB support and more vehicle colors. It also changes the user interface.'
          : page.description,
      };
    }
  }
} catch {}

const homeHeading = locale === 'en' ? 'we just making stuff' : page.lead;
const homeLead = locale === 'en' ? "and somehow it works" : page.description;
const eradicationRobloxUrl = getGameBySlug(locale, 'eradication')?.robloxUrl ?? 'https://www.roblox.com/games/16844978752/ERADICATION';

---

{/* homepage title stays on the short brand token; the full studio name is
    still present in the page description and Open Graph metadata. */}
<BaseLayout
  locale={locale}
  title="LQI"
  description={page.description}
  currentPage="home"
  routePath=""
  jsonLd={getHomeJsonLd(locale)}
>
  <div class="core-page core-page--home">
    <section class="home-ledger" aria-labelledby="hero-heading">
      <div class="home-statement">
        <h1 id="hero-heading" class="hero-enter" style="--enter-delay: 100ms">
          {locale === 'en' ? (
            <>
              <a href={getLocalePath(locale, '')}>we</a>{' '}
              <a href={getLocalePath(locale, 'connect')}>just</a>{' '}
              <a href={getLocalePath(locale, 'updates')}>making</a>{' '}
              <a href={getLocalePath(locale, 'games')}>stuff</a>
            </>
          ) : homeHeading}
        </h1>
        <p class="lead hero-enter" style="--enter-delay: 160ms">
          <a class="home-lead-link" href={eradicationRobloxUrl} target="_blank" rel="noopener noreferrer">{homeLead}</a>
        </p>
      </div>
    </section>

    <section class="home-lower" aria-label={messages.pages.game.latestUpdate} data-latest-cover={latestUpdate?.cover || undefined}>
      <div class="home-latest">
        <div class="ledger-heading">
          <h2>{messages.pages.game.latestUpdate}</h2>
        </div>
        {latestUpdate && (
          <article class="latest-entry">
            <div class="latest-meta">
              <time datetime="2026-07-21">{latestUpdate.date}</time>
              <span>{latestUpdate.game}</span>
            </div>
            <h3>{latestUpdate.version} for {latestUpdate.game}</h3>
            <p>{latestUpdate.summary}</p>
            <a class="ledger-link" href={`${getLocalePath(locale, 'updates')}#${latestUpdate.id}`}>{page.readUpdates}</a>
          </article>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Temporary visual flag; re-enable when the cover treatment is ready.
  const enableCoverScroll = false;

  if (enableCoverScroll) {
    const latestSection = document.querySelector<HTMLElement>('[data-latest-cover]');
    const latestCover = latestSection?.dataset.latestCover;

    if (latestSection && latestCover) {
      document.documentElement.style.setProperty('--latest-cover', `url("${latestCover}")`);

      const setCoverState = (active: boolean) => {
        document.documentElement.classList.toggle('home-cover-active', active);
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          ([entry]) => setCoverState(entry.isIntersecting),
          { threshold: 0, rootMargin: '0px 0px -45% 0px' },
        );
        observer.observe(latestSection);
      }
    }
  }
</script>
