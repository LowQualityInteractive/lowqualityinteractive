---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConnectJsonLd } from '../data/games';
import { CONTACT_EMAIL, SOCIAL_LINKS, getSiteTitle } from '../data/site';
import { getMessages, sanitizeInlineScript, type Locale } from '../i18n/messages';
import { getConnectScript } from '../scripts/connect';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const page = messages.pages.connect;
const platformLabels = messages.chrome.platforms;
const connectScript = sanitizeInlineScript(getConnectScript());

---

<BaseLayout
  locale={locale}
  title={getSiteTitle('Contact')}
  description={page.description}
  currentPage="connect"
  routePath="connect"
  jsonLd={getConnectJsonLd(locale)}
  extraScripts={[connectScript]}
>
  <div class="core-page core-page--connect">
    <section class="core-intro">
      <div>
        <h1 class="hero-enter" style="--enter-delay: 100ms">{page.heading}</h1>
      </div>
    </section>

    <section class="contact-directory">
      {/* Reveal the group, not each pill: individual reveal transforms can
          otherwise temporarily override the pill hover scale. */}
      <div class="platform-grid" data-reveal aria-label={page.platformsAriaLabel}>
        <a class="platform-card platform-card--discord" href={SOCIAL_LINKS.discord} target="_blank" rel="noopener noreferrer" aria-label={platformLabels.discord}>
          <img class="platform-logo" src="/assets/platforms/discord.png" alt={platformLabels.discord} width="48" height="48" />
        </a>
        <a class="platform-card platform-card--youtube" href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer" aria-label={platformLabels.youtube}>
          <img class="platform-logo" src="/assets/platforms/youtube.png" alt={platformLabels.youtube} width="48" height="48" />
        </a>
        <a class="platform-card platform-card--roblox" href={SOCIAL_LINKS.roblox} target="_blank" rel="noopener noreferrer" aria-label={platformLabels.robloxGroup}>
          <svg class="platform-logo platform-logo--roblox" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#111" d="M5.5 2.5 2.5 18.5l16 3 3-16-16-3Z" />
            <path fill="var(--platform-bg)" d="m10.5 10-.75 3.75 3.75.75.75-3.75-3.75-.75Z" />
          </svg>
        </a>
        <a class="platform-card platform-card--x" href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer" aria-label={platformLabels.x}>
          <img class="platform-logo" src="/assets/platforms/x.png" alt={platformLabels.x} width="48" height="48" />
        </a>
        <button class="platform-card platform-card--business" data-email-copy data-uisfx="copy" data-email={CONTACT_EMAIL} data-copy-label={page.copyEmailAriaLabel} data-copied-label={page.copied} data-business-label={page.businessHeading} type="button" aria-label={page.copyEmailAriaLabel} title={page.businessHeading}>
          <svg class="platform-logo platform-logo--mail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g class="mail-glyph">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path d="m4 7 8 6 8-6" />
            </g>
            <g class="check-glyph">
              <path d="m5 12.5 4.25 4.25L19 7" />
            </g>
          </svg>
        </button>
      </div>
    </section>
  </div>
</BaseLayout>
