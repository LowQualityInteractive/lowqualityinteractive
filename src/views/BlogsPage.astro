---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getBlogsJsonLd, getPublishedGames } from '../data/games';
import { getSiteTitle } from '../data/site';
import { getBlogsScript } from '../scripts/blogs';
import { getMessages, sanitizeInlineScript, type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const page = messages.pages.blogs;
const localizedGames = Object.fromEntries(
  getPublishedGames(locale).map((game) => [
    game.id,
    {
      name: game.name,
      updateImageAlt: game.updateImageAlt,
    },
  ]),
);
const blogsScript = sanitizeInlineScript(
  getBlogsScript(messages.blogsViewer, localizedGames, locale),
);
---

<BaseLayout
  locale={locale}
  title={getSiteTitle('Updates')}
  description={page.description}
  currentPage="updates"
  routePath="updates"
  jsonLd={getBlogsJsonLd(locale)}
  extraScripts={[blogsScript]}
>
  <div class="core-page core-page--updates">
    <section class="core-intro">
      <div>
        <h1 class="hero-enter" style="--enter-delay: 100ms">{page.heading}</h1>
      </div>
    </section>

    <section class="updates-workspace" aria-label={page.chooseDevlogAriaLabel}>
      <div class="updates-selector" data-reveal>
        <div class="game-devlog-buttons" id="devlog-game-buttons">
          <p>{page.loadingGames}</p>
        </div>
      </div>

      <div class="updates-reader devlog-viewer-card" id="devlog-viewer" aria-live="polite" data-reveal data-reveal-i="1">
        <h2>{page.viewerHeading}</h2>
        <p>{page.viewerFallback}</p>
      </div>
    </section>
  </div>
</BaseLayout>
