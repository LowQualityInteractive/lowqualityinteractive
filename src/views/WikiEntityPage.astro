---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGameBySlug } from '../data/games';
import { getSiteTitle } from '../data/site';
import {
  getCategoryHref,
  getCategoryLabel,
  getEntityPageTitle,
  getWikiCategory,
  getWikiEntity,
  getWikiHubHref,
  isUnpublished,
  resolveRelated,
} from '../data/wiki';
import { getLocalePath, type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
  gameSlug: string;
  categorySlug: string;
  entityId: string;
}

const { locale, gameSlug, categorySlug, entityId } = Astro.props;
const game = getGameBySlug(locale, gameSlug);
if (!game) throw new Error(`Unknown game slug: ${gameSlug}`);

const category = getWikiCategory(gameSlug, categorySlug);
if (!category) throw new Error(`Unknown wiki category: ${gameSlug}/${categorySlug}`);

const entity = getWikiEntity(gameSlug, categorySlug, entityId);
if (!entity) throw new Error(`Unknown wiki entity: ${gameSlug}/${categorySlug}/${entityId}`);

const label = getCategoryLabel(entity.type ?? category.category);
const title = getSiteTitle(getEntityPageTitle(game.name, entity));
const description = entity.summary;
const related = resolveRelated(locale, gameSlug, entity);
const statsEntries = entity.stats ? Object.entries(entity.stats) : [];
const funFacts = entity.fun_facts ?? [];
const unpublished = isUnpublished(entity);
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  currentPage="games"
  routePath={`${gameSlug}/wiki/${category.filename}/${entity.id}`}
  ogImage={game.artwork.src}
  ogImageAlt={game.artwork.alt}
>
  <section class="hero">
    {/* data-translatable hooks the mymemory runtime translator. proper
        names (game name, entity name) stay in their own untagged spans
        so the original brand text survives the translation pass. */}
    <span class="kicker hero-enter" style="--enter-delay: 40ms" data-translatable>
      {game.name} · {label.singular}
    </span>
    <h1 class="hero-enter" style="--enter-delay: 120ms">
      <span>{entity.name}</span>
      {unpublished && <span class="wiki-pill wiki-pill-unpub" data-translatable>Unpublished</span>}
      {entity.status === 'sunset' && <span class="wiki-pill" data-translatable>Sunset</span>}
      {entity.status === 'preview' && <span class="wiki-pill wiki-pill-preview" data-translatable>Preview</span>}
    </h1>
    <p class="lead hero-enter" style="--enter-delay: 220ms" data-translatable>{entity.summary}</p>
    <div class="cta-row hero-enter" style="--enter-delay: 300ms">
      <a class="button ghost" href={getCategoryHref(locale, gameSlug, category.filename)}>
        <span data-translatable>All {label.plural.toLowerCase()}</span>
      </a>
      <a class="button ghost" href={getWikiHubHref(locale, gameSlug)}>
        <span data-translatable>Wiki home</span>
      </a>
      <a class="button ghost" href={getLocalePath(locale, gameSlug)}>
        <span>{game.name}</span>
      </a>
    </div>
  </section>

  {entity.role && (
    <section class="wiki-section" data-reveal>
      <h2 class="wiki-section-heading" data-translatable>Role</h2>
      <p class="wiki-section-body" data-translatable>{entity.role}</p>
    </section>
  )}

  {statsEntries.length > 0 && (
    <section class="wiki-section" data-reveal>
      <h2 class="wiki-section-heading" data-translatable>Stats</h2>
      <dl class="wiki-stats">
        {statsEntries.map(([key, value]) => (
          <div class="wiki-stat">
            {/* stat keys are short generic words ("damage", "rate of
                fire") that benefit from translation; values are
                usually numbers/units, leave those as-is to avoid
                mymemory turning "12" into something silly. */}
            <dt data-translatable>{key.replace(/_/g, ' ')}</dt>
            <dd>{String(value)}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  {funFacts.length > 0 && (
    <section class="wiki-section" data-reveal>
      <h2 class="wiki-section-heading" data-translatable>Fun Facts</h2>
      <ul class="wiki-facts">
        {funFacts.map((fact) => <li data-translatable>{fact}</li>)}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="wiki-section" data-reveal>
      <h2 class="wiki-section-heading" data-translatable>Related</h2>
      <ul class="wiki-related" aria-label="Related entries">
        {related.map((relation) => (
          <li>
            {relation.resolved ? (
              <a class="wiki-related-link" href={relation.href}>
                <span class="wiki-related-name">{relation.name}</span>
                <span class="wiki-related-type" data-translatable>{getCategoryLabel(relation.type).singular}</span>
              </a>
            ) : (
              <span class="wiki-related-link wiki-related-link-missing" aria-label={`${relation.name} (unpublished)`}>
                <span class="wiki-related-name">{relation.name}</span>
                <span class="wiki-related-type" data-translatable>Unpublished</span>
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {unpublished && (
    <section class="wiki-section" data-reveal>
      <p class="wiki-unpublished-note" data-translatable>
        This entry is marked unpublished. The structure is in place but the studio hasn't released its official details yet.
      </p>
    </section>
  )}

  <footer class="wiki-doc-footer" data-reveal>
    <p>
      <span data-translatable>Official documentation for {game.name}.</span>
      {entity.last_verified && <span class="wiki-doc-verified"> · <span data-translatable>Last verified</span> <time datetime={entity.last_verified}>{entity.last_verified}</time></span>}
    </p>
  </footer>
</BaseLayout>
