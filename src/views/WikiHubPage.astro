---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGameBySlug } from '../data/games';
import { getSiteTitle } from '../data/site';
import {
  getCategoryHref,
  getCategoryLabel,
  getWikiCategories,
} from '../data/wiki';
import { getLocalePath, type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
  gameSlug: string;
}

const { locale, gameSlug } = Astro.props;
const game = getGameBySlug(locale, gameSlug);
if (!game) throw new Error(`Unknown game slug: ${gameSlug}`);

const categories = getWikiCategories(gameSlug);
const totalEntities = categories.reduce((sum, c) => sum + c.entities.length, 0);

const title = getSiteTitle(`${game.name} Wiki`);
const description = `Reference wiki for ${game.name}: weapons, enemies, maps, modes, items. Authoritative entries with stats and cross-links.`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  currentPage="games"
  routePath={`${gameSlug}/wiki`}
  ogImage={game.artwork.src}
  ogImageAlt={game.artwork.alt}
>
  <section class="hero wiki-hero">
    {/* data-translatable hooks the runtime mymemory translator. wiki
        copy is generated in english; the existing translate.ts walks
        these nodes after paint and swaps in the locale text. game and
        entity proper names are wrapped in their own non-translatable
        spans so we don't mangle them ("ERADICATION" should stay
        "ERADICATION" in every language). */}
    <a
      class="game-back-link wiki-hub-back-link hero-enter"
      style="--enter-delay: 40ms"
      href={getLocalePath(locale, gameSlug)}
      aria-label={`Back to ${game.name}`}
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" width="16" height="16">
        <path d="M13 8H3m4-4-4 4 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <h1 class="hero-enter" style="--enter-delay: 120ms" data-translatable>{game.name} Wiki</h1>
    <p class="lead hero-enter" style="--enter-delay: 220ms" data-translatable>
      {totalEntities} {totalEntities === 1 ? 'page' : 'pages'} across {categories.length} {categories.length === 1 ? 'category' : 'categories'}.
    </p>
  </section>

  <div class="wiki-grid wiki-index" aria-label="Wiki categories">
    {categories.map((category, i) => {
      const label = getCategoryLabel(category.category);
      return (
        <a
          class="wiki-card"
          href={getCategoryHref(locale, gameSlug, category.filename)}
          data-reveal
          data-reveal-i={String(Math.min(i + 1, 6))}
        >
          <div class="wiki-card-head">
            <span class="wiki-card-kicker" data-translatable>{category.entities.length} {category.entities.length === 1 ? 'page' : 'pages'}</span>
            <h2 class="wiki-card-title" data-translatable>{label.plural}</h2>
          </div>
          <ul class="wiki-card-preview" aria-hidden="true">
            {category.entities.slice(0, 3).map((entity) => (
              <li>{entity.name}</li>
            ))}
            {category.entities.length > 3 && <li class="wiki-card-preview-more" data-translatable>+{category.entities.length - 3} more</li>}
          </ul>
          <span class="wiki-card-arrow" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      );
    })}
  </div>

  <p class="wiki-doc-footer" data-reveal data-translatable>
    Official documentation for {game.name}.
  </p>
</BaseLayout>
