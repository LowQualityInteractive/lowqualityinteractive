---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getGameBySlug } from '../data/games';
import { getSiteTitle } from '../data/site';
import {
  getCategoryIntro,
  getCategoryLabel,
  getEntityHref,
  getWikiCategory,
  getWikiHubHref,
  isUnpublished,
} from '../data/wiki';
import { type Locale } from '../i18n/messages';

interface Props {
  locale: Locale;
  gameSlug: string;
  categorySlug: string;
}

const { locale, gameSlug, categorySlug } = Astro.props;
const game = getGameBySlug(locale, gameSlug);
if (!game) throw new Error(`Unknown game slug: ${gameSlug}`);

const category = getWikiCategory(gameSlug, categorySlug);
if (!category) throw new Error(`Unknown wiki category: ${gameSlug}/${categorySlug}`);

const label = getCategoryLabel(category.category);
const title = getSiteTitle(label.plural);
const intro = getCategoryIntro(category.category, game.name);
// prefer the prose intro for the meta description when one exists -
// it reads as a real summary instead of a comma-separated entity dump.
// the entity-list fallback stays for unrecognised categories.
const description = intro
  || `Every ${label.singular.toLowerCase()} in ${game.name}: ${category.entities.map((e) => e.name).join(', ')}.`;
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  currentPage="games"
  routePath={`${gameSlug}/wiki/${category.filename}`}
  ogImage={game.artwork.src}
  ogImageAlt={game.artwork.alt}
>
  <section class="hero wiki-template-hero wiki-category-hero">
    {/* data-translatable lets the runtime mymemory translator replace
        wiki copy on non-en pages. proper names (game/entity) stay in
        their own non-translatable spans so they aren't transformed. */}
    <a
      class="wiki-template-back-link hero-enter"
      style="--enter-delay: 40ms"
      href={getWikiHubHref(locale, gameSlug)}
      aria-label="Back to wiki"
    >
      <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" width="16" height="16">
        <path d="M13 8H3m4-4-4 4 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
    <h1 class="hero-enter wiki-template-title" style="--enter-delay: 100ms" data-translatable>{label.plural}</h1>
    {intro && (
      <p class="lead hero-enter" style="--enter-delay: 180ms" data-translatable>{intro}</p>
    )}
    <p class="hero-enter wiki-category-count" style="--enter-delay: 240ms" data-translatable>
      {category.entities.length} {category.entities.length === 1 ? 'page' : 'pages'}
    </p>
  </section>

  <div class="wiki-list" aria-label={`${label.plural} list`}>
    {category.entities.map((entity, i) => (
      <a
        class="wiki-row"
        href={getEntityHref(locale, gameSlug, category.filename, entity.id)}
        data-reveal
        data-reveal-i={String(Math.min(i + 1, 6))}
      >
        <div class="wiki-row-main">
          <h2 class="wiki-row-title">
            <span>{entity.name}</span>
            {isUnpublished(entity) && <span class="wiki-pill wiki-pill-unpub" data-translatable>Unpublished</span>}
            {entity.status === 'sunset' && <span class="wiki-pill" data-translatable>Sunset</span>}
            {entity.status === 'preview' && <span class="wiki-pill wiki-pill-preview" data-translatable>Preview</span>}
          </h2>
          {entity.role && <p class="wiki-row-role" data-translatable>{entity.role}</p>}
          <p class="wiki-row-summary" data-translatable>{entity.summary}</p>
        </div>
        <span class="wiki-row-arrow" aria-hidden="true">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    ))}
  </div>

  <p class="wiki-doc-footer" data-reveal data-translatable>
    Official documentation for {game.name}.
  </p>
</BaseLayout>
