---
import type { GetStaticPaths } from 'astro';
import { publishedGameSlugs } from '../../data/games';

export const getStaticPaths: GetStaticPaths = () =>
  publishedGameSlugs.map((slug) => ({
    params: { slug },
    props: { slug },
  }));

interface Props {
  slug: string;
}

return Astro.redirect(`/fr/${Astro.props.slug}/about`, 301);
---
