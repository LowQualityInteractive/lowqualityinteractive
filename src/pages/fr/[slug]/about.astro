---
// canonical game page is /fr/<slug> now. this file is here only so
// cached /fr/<slug>/about urls don't 404 — permanent redirect to the
// canonical path.
import type { GetStaticPaths } from 'astro';
import { publishedGameSlugs } from '../../../data/games';

export const getStaticPaths: GetStaticPaths = () =>
  publishedGameSlugs.map((slug) => ({
    params: { slug },
    props: { slug },
  }));

interface Props {
  slug: string;
}

return Astro.redirect(`/fr/${Astro.props.slug}/`, 301);
---
