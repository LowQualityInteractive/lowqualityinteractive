---
import type { GetStaticPaths } from 'astro';
import WikiHubPage from '../../../../views/WikiHubPage.astro';
import { getWikiHubStaticPaths } from '../../../../data/wiki';

export const getStaticPaths: GetStaticPaths = () => getWikiHubStaticPaths();

interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<WikiHubPage locale="it" gameSlug={slug} />
