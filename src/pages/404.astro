---
import '../styles/global.css';
import { getSiteTitle } from '../data/site';
import { LOCALES, LOCALE_OPTIONS, cspScriptHash, getLocalePath, getMessages, sanitizeInlineScript } from '../i18n/messages';
import { getNotFoundScript } from '../scripts/notFound';
import { getSiteScript } from '../scripts/site';
import { getThemeScript } from '../scripts/theme';
import { getCookiesBootstrap } from '../scripts/cookies';
import { getMotionBootstrap, getMotionScript } from '../scripts/motion';

const english = getMessages('en');
const page = english.pages.notFound;
const cookiesBootstrap = sanitizeInlineScript(getCookiesBootstrap());
const themeScript = sanitizeInlineScript(getThemeScript());
const siteScript = sanitizeInlineScript(
  getSiteScript(
    {
      mobileNav: english.chrome.mobileNav,
      localeSwitcher: english.chrome.localeSwitcher,
    },
    LOCALE_OPTIONS,
    false,
  ),
);
const notFoundScriptRaw = sanitizeInlineScript(
  getNotFoundScript(
    Object.fromEntries(
      LOCALES.map((locale) => {
        const messages = getMessages(locale);
        return [
          locale,
          {
            locale,
            title: getSiteTitle(messages.pages.notFound.label),
            description: messages.pages.notFound.description,
            kicker: messages.pages.notFound.kicker,
            heading: messages.pages.notFound.heading,
            copy: messages.pages.notFound.copy,
            goHome: messages.pages.notFound.goHome,
            viewGames: messages.pages.notFound.viewGames,
            homeHref: getLocalePath(locale),
            gamesHref: getLocalePath(locale, 'games'),
          },
        ];
      }),
    ),
  ),
);
const notFoundScript = notFoundScriptRaw;
const motionBootstrap = sanitizeInlineScript(getMotionBootstrap());
const motionScript = sanitizeInlineScript(getMotionScript());

const scripts404 = [cookiesBootstrap, themeScript, motionBootstrap, siteScript, notFoundScript, motionScript];
const scriptHashes = scripts404.map(cspScriptHash).join(' ');
const csp404 = [
  "default-src 'self'",
  `script-src 'self' ${scriptHashes}`,
  "style-src 'self' 'unsafe-inline'",
  "font-src 'self'",
  "img-src 'self' data: https:",
  "connect-src 'self'",
  "base-uri 'self'",
  "form-action 'self'",
  "frame-ancestors 'none'",
  "object-src 'none'",
].join('; ');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content={csp404} />
  <title>{getSiteTitle(page.label)}</title>
  <meta name="description" content={page.description} />
  {/* self-hosted fonts (see global.css @font-face). preload the two
      above-the-fold latin weights; no third-party font request. */}
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin-800.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/logo-96.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/logo.png" />
  <link rel="apple-touch-icon" href="/assets/logo.png" />
  <link rel="alternate" type="text/plain" title={english.meta.llmContextTitle} href="/llms.txt">
  <script is:inline set:html={cookiesBootstrap}></script>
  <script is:inline set:html={themeScript}></script>
  <script is:inline set:html={motionBootstrap}></script>
</head>
<body>
  <main class="not-found-main">
    <div class="container not-found-shell">
      <div class="not-found-card">
        <p class="kicker hero-enter" style="--enter-delay: 40ms" id="not-found-kicker">{page.kicker}</p>
        <h1 class="not-found-title hero-enter" style="--enter-delay: 120ms" id="not-found-heading">{page.heading}</h1>
        <p class="not-found-copy hero-enter" style="--enter-delay: 220ms" id="not-found-copy">{page.copy}</p>
        <div class="cta-row not-found-actions hero-enter" style="--enter-delay: 300ms">
          <a class="button primary" id="not-found-home" href={getLocalePath('en')}>
            <span>{page.goHome}</span>
            <svg class="btn-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" width="14" height="14">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a class="button ghost" id="not-found-games" href={getLocalePath('en', 'games')}>
            <span>{page.viewGames}</span>
            <svg class="btn-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" width="14" height="14">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </main>
  <script is:inline set:html={siteScript}></script>
  <script is:inline set:html={notFoundScript}></script>
  <script is:inline set:html={motionScript}></script>
  <script>
    import '../scripts/motion-runtime.ts';
  </script>
</body>
</html>
