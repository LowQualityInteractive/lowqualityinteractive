---
import type { GetStaticPaths } from 'astro';
import WikiCategoryPage from '../../../../../views/WikiCategoryPage.astro';
import { getWikiCategoryStaticPaths } from '../../../../../data/wiki';

export const getStaticPaths: GetStaticPaths = () => getWikiCategoryStaticPaths();

interface Props {
  slug: string;
  category: string;
}

const { slug, category } = Astro.props;
---

<WikiCategoryPage locale="de" gameSlug={slug} categorySlug={category} />
