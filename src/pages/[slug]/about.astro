---
// the canonical game page lives at /<slug> now. this file exists only
// so cached /<slug>/about urls — bookmarks, address-bar autocomplete,
// links shared from old chats — don't 404. it does nothing except
// permanent-redirect to the canonical path.
import type { GetStaticPaths } from 'astro';
import { publishedGameSlugs } from '../../data/games';

export const getStaticPaths: GetStaticPaths = () =>
  publishedGameSlugs.map((slug) => ({
    params: { slug },
    props: { slug },
  }));

interface Props {
  slug: string;
}

return Astro.redirect(`/${Astro.props.slug}/`, 301);
---
