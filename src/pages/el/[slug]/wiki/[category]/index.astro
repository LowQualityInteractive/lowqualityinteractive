---
import type { GetStaticPaths } from 'astro';
import WikiCategoryPage from '../../../../../views/WikiCategoryPage.astro';
import { WIKI_GAME_SLUGS, getWikiCategories } from '../../../../../data/wiki';

export const getStaticPaths: GetStaticPaths = () => {
  const paths: Array<{ params: { slug: string; category: string }; props: { slug: string; category: string } }> = [];
  for (const slug of WIKI_GAME_SLUGS) {
    for (const cat of getWikiCategories(slug)) {
      paths.push({
        params: { slug, category: cat.filename },
        props: { slug, category: cat.filename },
      });
    }
  }
  return paths;
};

interface Props {
  slug: string;
  category: string;
}

const { slug, category } = Astro.props;
---

<WikiCategoryPage locale="el" gameSlug={slug} categorySlug={category} />
