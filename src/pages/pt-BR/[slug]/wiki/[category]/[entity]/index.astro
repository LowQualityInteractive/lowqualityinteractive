---
import type { GetStaticPaths } from 'astro';
import WikiEntityPage from '../../../../../../views/WikiEntityPage.astro';
import { getWikiEntityStaticPaths } from '../../../../../../data/wiki';

export const getStaticPaths: GetStaticPaths = () => getWikiEntityStaticPaths();

interface Props {
  slug: string;
  category: string;
  entity: string;
}

const { slug, category, entity } = Astro.props;
---

<WikiEntityPage locale="pt-BR" gameSlug={slug} categorySlug={category} entityId={entity} />
