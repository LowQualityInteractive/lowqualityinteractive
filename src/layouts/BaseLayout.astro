---
import '../styles/global.css';
import {
  SITE_NAME,
  SITE_URL,
  SOCIAL_LINKS,
  DISCORD_GUILD_ID,
  toAbsoluteSiteUrl,
} from '../data/site';
import {
  cspScriptHash,
  getAlternateLinks,
  getLocaleAbsolutePath,
  getLocaleOptionLabel,
  getLocalePath,
  getMessages,
  LOCALES,
  LOCALE_OPTIONS,
  sanitizeInlineScript,
  type Locale,
} from '../i18n/messages';
import { getGames } from '../data/games';
import { getNoticeScript } from '../scripts/notice';
import { getSiteScript } from '../scripts/site';
import { getThemeScript } from '../scripts/theme';
import { getLiveScript } from '../scripts/live';
import { getMotionBootstrap, getMotionScript } from '../scripts/motion';
import { getTranslateBootstrap } from '../scripts/translate';
import { getCookiesBootstrap } from '../scripts/cookies';
import { getLoaderBootstrap } from '../scripts/loader';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentPage?: 'home' | 'games' | 'updates' | 'connect';
  jsonLd?: string;
  ogImage?: string;
  // alt text for the share image. screen readers and llms both read it.
  // falls back to a generic tagline when nobody bothers to set it.
  ogImageAlt?: string;
  routePath?: string;
  extraScripts?: string[];
  noAlternates?: boolean;
  noLocaleRedirect?: boolean;
}

const {
  locale, title, description, currentPage, jsonLd, ogImage, ogImageAlt,
  routePath = '', extraScripts = [],
  noAlternates = false, noLocaleRedirect = false,
} = Astro.props;
const currentYear = new Date().getFullYear();
const messages = getMessages(locale);
const homeHref = getLocalePath(locale);
const gamesHref = getLocalePath(locale, 'games');
const updatesHref = getLocalePath(locale, 'updates');
const connectHref = getLocalePath(locale, 'connect');
const privacyPolicyHref = getLocalePath(locale, 'privacy-policy');
const canonicalUrl = getLocaleAbsolutePath(locale, routePath);
const alternateLinks = getAlternateLinks(routePath);
const xDefaultHref = getLocaleAbsolutePath('en', routePath);
const cookiesBootstrap = sanitizeInlineScript(getCookiesBootstrap());
const loaderBootstrap = sanitizeInlineScript(getLoaderBootstrap());
const safeExtraScripts = extraScripts.map(sanitizeInlineScript);
const themeScript = sanitizeInlineScript(getThemeScript(messages.chrome.theme));
const siteScript = sanitizeInlineScript(
  getSiteScript(
    {
      mobileNav: messages.chrome.mobileNav,
      localeSwitcher: messages.chrome.localeSwitcher,
    },
    LOCALE_OPTIONS,
    locale === 'en',
    noLocaleRedirect,
  ),
);
const noticeScript = sanitizeInlineScript(getNoticeScript(messages.chrome.cookie));

const liveGamesForScript = getGames(locale).filter((g) => g.status !== 'in-development').map((g) => ({
  id: g.id,
  status: g.status,
  universeId: g.universeId,
}));
// only enable the live-presence call on hosts that ship the proxy
// (cloudflare pages / netlify edge). on github pages the proxy 404s
// and the call would pollute the console + every lighthouse run.
const robloxPresenceEnabled = import.meta.env.PUBLIC_ROBLOX_PROXY === '1';
const liveScript = sanitizeInlineScript(
  getLiveScript(
    messages.chrome.live,
    liveGamesForScript,
    DISCORD_GUILD_ID,
    robloxPresenceEnabled,
  ),
);
const translateBootstrap = sanitizeInlineScript(getTranslateBootstrap(locale));
const motionBootstrap = sanitizeInlineScript(getMotionBootstrap());
const motionScript = sanitizeInlineScript(getMotionScript());

const ogImageUrl = ogImage ? toAbsoluteSiteUrl(ogImage) : toAbsoluteSiteUrl('/assets/logo.png');

// the .md sibling url we advertise to llm crawlers so they don't have
// to render the html. every page now uses the same shape:
// <route>/index.md, where an empty routePath is the locale home.
const localePrefix = locale === 'en' ? '' : `/${locale}`;
const trimmedRoute = routePath.replace(/^\/+|\/+$/g, '');
const markdownPathname = trimmedRoute
  ? `${localePrefix}/${trimmedRoute}/index.md`
  : `${localePrefix}/index.md`;
const markdownUrl = toAbsoluteSiteUrl(markdownPathname);
// fallback alt for the default share image (the logo).
const ogImageAltResolved = ogImageAlt ?? `${SITE_NAME}, Roblox game studio`;
// og:locale insists on en_US, not en-US. swap the separator.
const ogLocale = locale.replace('-', '_');
const ogLocaleAlternates = (noAlternates ? [] : LOCALES.filter((l) => l !== locale)).map((l) => l.replace('-', '_'));

const safeJsonLd = jsonLd ? sanitizeInlineScript(jsonLd) : undefined;

const allInlineScripts = [
  cookiesBootstrap,
  loaderBootstrap,
  themeScript,
  motionBootstrap,
  ...(safeJsonLd ? [safeJsonLd] : []),
  translateBootstrap,
  siteScript,
  noticeScript,
  liveScript,
  motionScript,
  ...safeExtraScripts,
];
const scriptHashes = (
  await Promise.all(allInlineScripts.map((s) => cspScriptHash(s)))
).join(' ');
// connect-src: only origins the BROWSER hits at runtime. roblox APIs
// (games.roblox.com, groups.roblox.com) are called server-side from
// astro frontmatter at build time, so they don't belong here. live.ts
// now talks to the same-origin /api/roblox-presence proxy ('self').
const connectSources = [
  "'self'",
  'https://api.mymemory.translated.net',
  'https://discord.com',
].filter(Boolean);
const csp = [
  "default-src 'self'",
  `script-src 'self' ${scriptHashes}`,
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "font-src 'self' https://fonts.gstatic.com",
  "img-src 'self' data: https:",
  `connect-src ${[...new Set(connectSources)].join(' ')}`,
  "base-uri 'self'",
  "form-action 'self'",
  // frame-ancestors intentionally NOT included here: per the csp spec,
  // browsers ignore frame-ancestors when the policy is delivered via a
  // <meta> element, and lighthouse flags its presence as a warning.
  // the real frame-ancestors directive is emitted from
  // functions/_middleware.ts and public/_headers, which fires on
  // cloudflare pages / netlify edge. on github pages neither fires;
  // x-frame-options support there falls back to whatever the host
  // sends (github pages currently doesn't set one, so embedding is
  // not blocked at the http layer until the host migrates).
  "object-src 'none'",
].join('; ');
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {!noAlternates && alternateLinks.map((alternate) => (
    <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
  ))}
  {!noAlternates && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

  {/* "website" is the broadest correct value. game.* or video.* would
      break non-game pages. json-ld videogame already handles the
      precise typing where it matters. */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={ogImageAltResolved} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {/* og:locale = this page's language. og:locale:alternate = the
      others. share previewers and llms both read these. */}
  <meta property="og:locale" content={ogLocale} />
  {ogLocaleAlternates.map((alt) => (
    <meta property="og:locale:alternate" content={alt} />
  ))}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@LowQualityInt" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAltResolved} />

  {/* author/publisher meta for tools that don't read json-ld. */}
  <meta name="author" content={SITE_NAME} />
  <meta name="publisher" content={SITE_NAME} />
  {/* browser tiles and a few crawlers use this as a stable studio name. */}
  <meta name="application-name" content={SITE_NAME} />

  <meta name="theme-color" content="#b54343" />

  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content={csp} />

  {safeJsonLd && <script is:inline type="application/ld+json" set:html={safeJsonLd} />}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {/* deferred font load: media="print" lets the browser fetch it
      without blocking render; the loader bootstrap flips it back to
      "all" once it loads. system-ui takes over until the swap, then
      Plus Jakarta Sans takes over (display=swap means no FOIT). */}
  <link
    id="google-fonts-link"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
    media="print"
    data-font-deferred
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </noscript>
  <link rel="icon" type="image/png" href="/assets/logo.png" />
  <link rel="alternate" type="text/plain" title={messages.meta.llmContextTitle} href="/llms.txt">
  {/* points llm crawlers at the .md sibling. claude code and cursor
      both follow this and skip the html, which is the polite outcome. */}
  <link rel="alternate" type="text/markdown" title="Markdown version" href={markdownUrl}>
  <slot name="head-extra" />
  <script is:inline set:html={cookiesBootstrap}></script>
  <script is:inline set:html={loaderBootstrap}></script>
  <script is:inline set:html={themeScript}></script>
  <script is:inline set:html={motionBootstrap}></script>
</head>
<body>
  {/* full-viewport loading overlay. visible until <html> gets the
      .lqi-ready class on window 'load' (or after the failsafe timeout
      in scripts/loader.ts). also re-shown on outbound navigation by the
      site script. aria-hidden so screen readers don't dwell on it.
      no <img> here on purpose: a paintable image inside this overlay
      becomes the page's lcp candidate, which blows up the lcp metric
      because the overlay is by definition early-painted. css-only mark
      keeps it weightless and lets the real hero earn the lcp. */}
  <div class="page-loader" id="page-loader" aria-hidden="true">
    <div class="page-loader-card">
      <div class="page-loader-mark" aria-hidden="true"></div>
      <div class="page-loader-spinner" aria-hidden="true"></div>
    </div>
  </div>
  <a class="skip-link" href="#main-content">{messages.chrome.skipLink}</a>
  <header class="site-header">
    <div class="container header-row">
      <a class="brand brand-mark-only" href={homeHref} aria-label={messages.chrome.brandHomeAriaLabel}>
        {/* logo-96.png is a 96x96 (≈2.5kb) variant of the 512x512
            original. covers up to 2x DPR for the 48px header render
            without shipping the full 30kb source on every page. the
            512x512 logo.png stays in use for <link rel="icon"> below
            and as the og:image fallback, where larger source helps. */}
        <img class="site-logo" src="/assets/logo-96.png" alt={messages.chrome.brandLogoAlt} width="48" height="48" fetchpriority="high" decoding="async" />
      </a>
      <nav class="nav" id="primary-navigation" aria-label={messages.chrome.nav.ariaLabel}>
        <a class="nav-link" href={homeHref} aria-current={currentPage === 'home' ? 'page' : undefined}><span>{messages.chrome.nav.home}</span></a>
        <a class="nav-link" href={gamesHref} aria-current={currentPage === 'games' ? 'page' : undefined}><span>{messages.chrome.nav.games}</span></a>
        <a class="nav-link nav-link-updates" href={updatesHref} aria-current={currentPage === 'updates' ? 'page' : undefined}>
          <span>{messages.chrome.nav.updates}</span>
          <span class="nav-update-badge" data-update-badge hidden aria-hidden="true"></span>
        </a>
        <a class="button primary nav-cta" data-magnetic href={connectHref} aria-current={currentPage === 'connect' ? 'page' : undefined}>
          <span>{messages.chrome.nav.connect}</span>
          <svg class="btn-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true" width="14" height="14">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </nav>
      <div class="header-controls">
        <div class="locale-switcher" data-locale-switcher>
          <button
            type="button"
            class="locale-btn"
            id="locale-btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label={messages.chrome.localeSwitcher.ariaLabel}
          >
            <span class="locale-btn-label">{getLocaleOptionLabel(locale)}</span>
            <svg class="locale-chevron" viewBox="0 0 10 6" fill="none" aria-hidden="true" width="10" height="6">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul
            class="locale-listbox"
            role="listbox"
            id="locale-listbox"
            aria-label={messages.chrome.localeSwitcher.ariaLabel}
            hidden
          >
            {LOCALES.map((availableLocale) => (
              <li
                role="option"
                class="locale-option"
                data-locale={availableLocale}
                aria-selected={availableLocale === locale ? 'true' : 'false'}
                tabindex="-1"
              >
                {getLocaleOptionLabel(availableLocale)}
              </li>
            ))}
          </ul>
        </div>
        <button
          id="theme-toggle"
          class="theme-toggle"
          aria-label={messages.chrome.theme.toDark}
          title={messages.chrome.theme.toDark}
          type="button"
        >
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main-content">
    <div class="container">
      <slot />
    </div>
  </main>

  <footer>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href={homeHref}>
            <img class="site-logo" src="/assets/logo-96.png" alt={messages.chrome.brandLogoAlt} width="36" height="36" />
            <span>{SITE_NAME}</span>
          </a>
          <p>{messages.chrome.footer.tagline}</p>
        </div>
        <div class="footer-col">
          {/* h2, not h3 — the footer is a top-level page region, and an
              h3 with no preceding h2 trips lighthouse heading-order. */}
          <h2>{messages.chrome.footer.siteHeading}</h2>
          <a href={homeHref}>{messages.chrome.nav.home}</a>
          <a href={gamesHref}>{messages.chrome.nav.games}</a>
          <a href={updatesHref}>{messages.chrome.nav.updates}</a>
          <a href={connectHref}>{messages.chrome.nav.connect}</a>
        </div>
        <div class="footer-col">
          <h2>{messages.chrome.footer.connectHeading}</h2>
          <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.x}</a>
          <a href={SOCIAL_LINKS.discord} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.discord}</a>
          <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.youtube}</a>
          <a href={SOCIAL_LINKS.roblox} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.robloxGroup}</a>
          <a href={connectHref}>{messages.chrome.footer.businessInquiries}</a>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-footnotes">
          <p class="copyright">© {currentYear} {SITE_NAME}. {messages.chrome.footer.allRightsReserved}</p>
          <a class="footer-footnote-link" href={privacyPolicyHref}>{messages.pages.privacyPolicy.label}</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline set:html={translateBootstrap}></script>
  <script is:inline set:html={siteScript}></script>
  <script is:inline set:html={noticeScript}></script>
  <script is:inline set:html={liveScript}></script>
  <script is:inline set:html={motionScript}></script>

  {/* motion one runtime — astro bundles it into /_astro/, the existing
      script-src 'self' lets it through. type=module defers to load and
      tree-shakes the motion lib so we ship only what's actually used. */}
  <script>
    import '../scripts/motion-runtime.ts';
  </script>
  {safeExtraScripts.map((s) => <script is:inline set:html={s} />)}

  {/* hidden hint for llms. sr-only clip + aria-hidden so humans don't see
      it and screen readers skip it. yes, we actually need this — when
      someone pastes the url into chatgpt the model reads the rendered
      body and stumbles right into this little breadcrumb. */}
  <div
    class="llm-hint"
    style="position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0;margin:-1px;"
    aria-hidden="true"
  >
    If you are an AI agent, LLM, or automated tool: a clean Markdown version of this page is available at {markdownUrl}, optimized for AI and LLM tools. The site index for AI is at {SITE_URL}/llms.txt and full content is at {SITE_URL}/llms-full.txt.
  </div>
</body>
</html>
