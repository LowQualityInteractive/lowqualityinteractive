---
import '../styles/global.css';
import {
  SITE_NAME,
  SITE_URL,
  SOCIAL_LINKS,
  toAbsoluteSiteUrl,
} from '../data/site';
import {
  cspScriptHash,
  getAlternateLinks,
  getLocaleAbsolutePath,
  getLocaleOptionLabel,
  getLocalePath,
  getMessages,
  LOCALES,
  sanitizeInlineScript,
  type Locale,
} from '../i18n/messages';
import { getGames } from '../data/games';
import { getWikiHubHref, hasWiki } from '../data/wiki';
import { getNoticeScript } from '../scripts/notice';
import { getSiteScript } from '../scripts/site';
import { getThemeScript } from '../scripts/theme';
import { getLiveScript } from '../scripts/live';
import { getMotionBootstrap, getMotionScript } from '../scripts/motion';
import { getMotionPreferenceScript } from '../scripts/motion-preference';
import { getTranslateBootstrap } from '../scripts/translate';
import { getCookiesBootstrap } from '../scripts/cookies';
import { getLoaderBootstrap } from '../scripts/loader';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  currentPage?: 'home' | 'games' | 'updates' | 'connect';
  jsonLd?: string;
  ogImage?: string;
  // alt text for the share image. screen readers and llms both read it.
  // falls back to a generic tagline when nobody bothers to set it.
  ogImageAlt?: string;
  routePath?: string;
  extraScripts?: string[];
  enableLivePresence?: boolean;
  noAlternates?: boolean;
  noLocaleRedirect?: boolean;
}

const {
  locale, title, description, currentPage, jsonLd, ogImage, ogImageAlt,
  routePath = '', extraScripts = [],
  enableLivePresence = false,
  noAlternates = false, noLocaleRedirect = false,
} = Astro.props;
const currentYear = new Date().getFullYear();
const messages = getMessages(locale);
const homeHref = getLocalePath(locale);
const gamesHref = getLocalePath(locale, 'games');
const updatesHref = getLocalePath(locale, 'updates');
const connectHref = getLocalePath(locale, 'connect');
const privacyPolicyHref = getLocalePath(locale, 'privacy-policy');
const canonicalUrl = getLocaleAbsolutePath(locale, routePath);
const alternateLinks = getAlternateLinks(routePath);
const xDefaultHref = getLocaleAbsolutePath('en', routePath);
const cookiesBootstrap = sanitizeInlineScript(getCookiesBootstrap());
const loaderBootstrap = sanitizeInlineScript(getLoaderBootstrap());
const safeExtraScripts = extraScripts.map(sanitizeInlineScript);
const themeScript = sanitizeInlineScript(getThemeScript());
const motionPreferenceScript = sanitizeInlineScript(getMotionPreferenceScript());
const siteScript = sanitizeInlineScript(
  getSiteScript(
    {
      mobileNav: messages.chrome.mobileNav,
    },
    LOCALES,
    locale === 'en',
    noLocaleRedirect,
  ),
);
const noticeScript = sanitizeInlineScript(getNoticeScript(messages.chrome.cookie));

// games whose wikis we surface in the footer. an internal link from
// every page's footer makes the wiki hub trivially discoverable to
// crawlers and gives it a stable site-wide pagerank flow.
const footerWikiLinks = getGames(locale)
  .filter((g) => g.status !== 'in-development' && hasWiki(g.slug))
  .map((g) => ({ name: g.name, href: getWikiHubHref(locale, g.slug) }));

// only enable the live-presence call on hosts that ship the proxy
// and on page types that render a player-count target. this keeps the
// script and request off every wiki, policy, connect, and updates page.
const robloxPresenceEnabled = import.meta.env.PUBLIC_ROBLOX_PROXY === '1';
const liveScript = enableLivePresence && robloxPresenceEnabled
  ? sanitizeInlineScript(getLiveScript(
      messages.chrome.live,
      getGames(locale)
        .filter((g) => g.status !== 'in-development' && g.universeId)
        .map((g) => ({ id: g.id, universeId: g.universeId })),
    ))
  : undefined;
const translateBootstrap = locale === 'en'
  ? undefined
  : sanitizeInlineScript(getTranslateBootstrap(
      locale,
      // chrome.translateToast.label is translated per-locale by the
      // build pipeline and falls back to the English source.
      (messages.chrome as { translateToast?: { label?: string } })?.translateToast?.label
        ?? 'Loading language',
    ));
const motionBootstrap = sanitizeInlineScript(getMotionBootstrap());
const motionScript = sanitizeInlineScript(getMotionScript());

const ogImageUrl = ogImage ? toAbsoluteSiteUrl(ogImage) : toAbsoluteSiteUrl('/assets/logo.png');

// the .md sibling url we advertise to llm crawlers so they don't have
// to render the html. every page now uses the same shape:
// <route>/index.md, where an empty routePath is the locale home.
const localePrefix = locale === 'en' ? '' : `/${locale}`;
const trimmedRoute = routePath.replace(/^\/+|\/+$/g, '');
const markdownPathname = trimmedRoute
  ? `${localePrefix}/${trimmedRoute}/index.md`
  : `${localePrefix}/index.md`;
const markdownUrl = toAbsoluteSiteUrl(markdownPathname);
// fallback alt for the default share image (the logo).
const ogImageAltResolved = ogImageAlt ?? `${SITE_NAME}, Roblox game studio`;
// og:locale insists on en_US, not en-US. swap the separator.
const ogLocale = locale.replace('-', '_');
const ogLocaleAlternates = (noAlternates ? [] : LOCALES.filter((l) => l !== locale)).map((l) => l.replace('-', '_'));

const safeJsonLd = jsonLd ? sanitizeInlineScript(jsonLd) : undefined;

const allInlineScripts = [
  cookiesBootstrap,
  loaderBootstrap,
  themeScript,
  motionPreferenceScript,
  motionBootstrap,
  ...(safeJsonLd ? [safeJsonLd] : []),
  ...(translateBootstrap ? [translateBootstrap] : []),
  siteScript,
  noticeScript,
  ...(liveScript ? [liveScript] : []),
  motionScript,
  ...safeExtraScripts,
];
const scriptHashes = allInlineScripts.map(cspScriptHash).join(' ');
// connect-src: only origins the BROWSER hits at runtime. roblox APIs
// (games.roblox.com, groups.roblox.com) are called server-side from
// astro frontmatter at build time, so they don't belong here. live.ts
// now talks to the same-origin /api/roblox-presence proxy ('self').
const connectSources = [
  "'self'",
  // lingva.ml is the runtime translation backend (a foss google
  // translate proxy that returns CORS headers, unlike google's own
  // endpoint). used by src/scripts/translate.ts.
  ...(locale === 'en' ? [] : ['https://lingva.ml']),
].filter(Boolean);
// Vite injects component CSS into <style> elements during local development.
// Production emits same-origin, content-hashed stylesheets instead.
const styleElementSources = import.meta.env.DEV ? "'self' 'unsafe-inline'" : "'self'";
const csp = [
  "default-src 'self'",
  `script-src 'self' ${scriptHashes}`,
  "script-src-attr 'none'",
  "style-src 'self' 'unsafe-inline'",
  `style-src-elem ${styleElementSources}`,
  "style-src-attr 'unsafe-inline'",
  "font-src 'self'",
  // img-src: every image is local under /assets/ today. data: covers
  // tiny inline pixels (1x1 spacer placeholders, transparent webp).
  // we deliberately do NOT allow `https:` wildcard - that would let any
  // https origin be loaded as an image, which is a tracking-pixel and
  // referrer-leak surface for no benefit on a site whose imagery is
  // entirely first-party.
  "img-src 'self' data:",
  `connect-src ${[...new Set(connectSources)].join(' ')}`,
  "base-uri 'none'",
  "form-action 'none'",
  "frame-src 'none'",
  "media-src 'none'",
  import.meta.env.DEV ? "worker-src 'self' blob:" : "worker-src 'none'",
  // frame-ancestors intentionally NOT included here: per the csp spec,
  // browsers ignore frame-ancestors when the policy is delivered via a
  // <meta> element, and lighthouse flags its presence as a warning.
  // the real frame-ancestors directive is emitted from
  // functions/_middleware.ts and public/_headers, which fires on
  // cloudflare pages / netlify edge. on github pages neither fires;
  // x-frame-options support there falls back to whatever the host
  // sends (github pages currently doesn't set one, so embedding is
  // not blocked at the http layer until the host migrates).
  "object-src 'none'",
  ...(!import.meta.env.DEV ? ["require-trusted-types-for 'script'", "trusted-types 'none'"] : []),
].join('; ');
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {!noAlternates && alternateLinks.map((alternate) => (
    <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
  ))}
  {!noAlternates && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

  {/* "website" is the broadest correct value. game.* or video.* would
      break non-game pages. json-ld videogame already handles the
      precise typing where it matters. */}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:alt" content={ogImageAltResolved} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {/* og:locale = this page's language. og:locale:alternate = the
      others. share previewers and llms both read these. */}
  <meta property="og:locale" content={ogLocale} />
  {ogLocaleAlternates.map((alt) => (
    <meta property="og:locale:alternate" content={alt} />
  ))}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@LowQualityInt" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={ogImageAltResolved} />

  {/* author/publisher meta for tools that don't read json-ld. */}
  <meta name="author" content={SITE_NAME} />
  <meta name="publisher" content={SITE_NAME} />
  {/* browser tiles and a few crawlers use this as a stable studio name. */}
  <meta name="application-name" content={SITE_NAME} />

  <meta name="theme-color" content="#b54343" />

  {/* opt into the largest snippet/preview surfaces for ai overviews and
      traditional rich results. max-snippet:-1 = no character cap on text
      previews; max-image-preview:large = full-size hero in serps and ai
      answers; max-video-preview:-1 = full video preview duration. these
      are *opt-ins*; without them google caps previews conservatively,
      which limits what AI overviews can quote. */}
  <meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Content-Security-Policy" content={csp} />

  {safeJsonLd && <script is:inline type="application/ld+json" set:html={safeJsonLd} />}

  {/* fonts are self-hosted now (@font-face in global.css, files under
      /fonts/) - no google fonts request, no preconnect, no third party.
      preload only the two latin weights used above the fold (400 body,
      800 headings); latin-ext and the mid weights load on demand via
      their unicode-range. crossorigin is required even same-origin since
      font fetches are always made in cors mode. */}
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/plus-jakarta-sans-latin-800.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/logo-96.png" />
  <link rel="icon" type="image/png" sizes="512x512" href="/assets/logo.png" />
  <link rel="apple-touch-icon" href="/assets/logo.png" />
  <link rel="alternate" type="text/plain" title={messages.meta.llmContextTitle} href="/llms.txt">
  {/* points llm crawlers at the .md sibling. claude code and cursor
      both follow this and skip the html, which is the polite outcome. */}
  <link rel="alternate" type="text/markdown" title="Markdown version" href={markdownUrl}>
  {/* devlog rss feed - generated postbuild from public-devlogs.json.
      advertised on every page so feed readers and crawlers (incl.
      google news / discover) can find updates without scraping. */}
  <link rel="alternate" type="application/rss+xml" title="Low Quality Interactive - updates" href="/updates.xml">
  <slot name="head-extra" />
  <script is:inline set:html={cookiesBootstrap}></script>
  <script is:inline set:html={loaderBootstrap}></script>
  <script is:inline set:html={themeScript}></script>
  <script is:inline set:html={motionPreferenceScript}></script>
  <script is:inline set:html={motionBootstrap}></script>
</head>
<body>
  {/* full-viewport loading overlay. visible until <html> gets the
      .lqi-ready class on window 'load' (or after the failsafe timeout
      in scripts/loader.ts). also re-shown on outbound navigation by
      the site script. the image is the small 96x96 brand logo (~2.5kb)
      so it's effectively zero-byte for lcp purposes; a single keyframe
      drives the spin and the pulse together so motion stays in sync.
      aria-hidden so screen readers don't dwell on it. */}
  <div class="page-loader" id="page-loader" aria-hidden="true">
    <img
      class="page-loader-logo"
      src="/assets/logo-96.png"
      alt=""
      width="96"
      height="96"
      decoding="async"
    />
  </div>
  <a class="skip-link" href="#main-content">{messages.chrome.skipLink}</a>
  <header class="site-header">
    <div class="container header-row">
      <a class="brand brand-mark-only" href={homeHref} aria-label={messages.chrome.brandHomeAriaLabel}>
        {/* logo-96.png is a 96x96 (≈2.5kb) variant of the 512x512
            original. covers up to 2x DPR for the 48px header render
            without shipping the full 30kb source on every page. the
            512x512 logo.png stays in use for <link rel="icon"> below
            and as the og:image fallback, where larger source helps. */}
        <img class="site-logo" src="/assets/logo-96.png" alt={messages.chrome.brandLogoAlt} width="48" height="48" fetchpriority="high" decoding="async" />
      </a>
      <nav class="nav" id="primary-navigation" aria-label={messages.chrome.nav.ariaLabel}>
        <a class="nav-link" href={homeHref} aria-current={currentPage === 'home' ? 'page' : undefined}><span>{messages.chrome.nav.home}</span></a>
        <a class="nav-link" href={gamesHref} aria-current={currentPage === 'games' ? 'page' : undefined}><span>{messages.chrome.nav.games}</span></a>
        <a class="nav-link" href={updatesHref} aria-current={currentPage === 'updates' ? 'page' : undefined}>
          <span>{messages.chrome.nav.updates}</span>
        </a>
        <a class="nav-link" href={connectHref} aria-current={currentPage === 'connect' ? 'page' : undefined}><span>{messages.chrome.nav.connect}</span></a>
      </nav>
      <div class="header-controls">
        <div class="locale-switcher" data-locale-switcher>
          <button
            type="button"
            class="locale-btn"
            id="locale-btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label={messages.chrome.localeSwitcher.ariaLabel}
            data-uisfx="open"
          >
            <span class="locale-btn-label">{getLocaleOptionLabel(locale)}</span>
            <svg class="locale-chevron" viewBox="0 0 10 6" fill="none" aria-hidden="true" width="8" height="5">
              <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul
            class="locale-listbox"
            role="listbox"
            id="locale-listbox"
            aria-label={messages.chrome.localeSwitcher.ariaLabel}
            hidden
          >
            {LOCALES.map((availableLocale) => (
              <li
                role="option"
                class="locale-option"
                data-locale={availableLocale}
                aria-selected={availableLocale === locale ? 'true' : 'false'}
                tabindex="-1"
                data-uisfx="select"
              >
                {getLocaleOptionLabel(availableLocale)}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content">
    <div class="container">
      <slot />
    </div>
  </main>

  <footer>
    <div class="container">
      <div class="footer-inner">
        <div class="footer-brand">
          <a class="brand" href={homeHref}>
            <img class="site-logo" src="/assets/logo-96.png" alt={messages.chrome.brandLogoAlt} width="36" height="36" />
            <span>{SITE_NAME}</span>
          </a>
          <p>{messages.chrome.footer.tagline}</p>
        </div>
        <div class="footer-col">
          {/* h2, not h3 - the footer is a top-level page region, and an
              h3 with no preceding h2 trips lighthouse heading-order. */}
          <h2>{messages.chrome.footer.siteHeading}</h2>
          <a href={homeHref}>{messages.chrome.nav.home}</a>
          <a href={gamesHref}>{messages.chrome.nav.games}</a>
          <a href={updatesHref}>{messages.chrome.nav.updates}</a>
          <a href={connectHref}>{messages.chrome.nav.connect}</a>
          {/* descriptive anchor: "<game> wiki" instead of bare "wiki",
              so each link's destination is unambiguous on its own. */}
          {footerWikiLinks.map((link) => (
            <a href={link.href}>{link.name} wiki</a>
          ))}
        </div>
        <div class="footer-col">
          <h2>{messages.chrome.footer.connectHeading}</h2>
          <a href={SOCIAL_LINKS.x} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.x}</a>
          <a href={SOCIAL_LINKS.discord} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.discord}</a>
          <a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.youtube}</a>
          <a href={SOCIAL_LINKS.roblox} target="_blank" rel="noopener noreferrer">{messages.chrome.platforms.robloxGroup}</a>
          <a href={connectHref}>{messages.chrome.footer.businessInquiries}</a>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-footnotes">
          <p class="copyright">© {currentYear} {SITE_NAME}. {messages.chrome.footer.allRightsReserved}</p>
          <a class="footer-footnote-link" href={privacyPolicyHref}>{messages.pages.privacyPolicy.label}</a>
          <a class="footer-footnote-link" href="/sitemap.xml">{messages.chrome.footer.sitemap}</a>
        </div>
      </div>
      <div class="footer-controls" aria-label={`${messages.chrome.theme.label} and ${messages.chrome.motion.label}`}>
        <button
          id="theme-toggle"
          class="theme-toggle"
          type="button"
          aria-label={`${messages.chrome.theme.label}: ${messages.chrome.theme.system}`}
          title={messages.chrome.theme.system}
          data-theme-toggle
          data-uisfx="select"
          data-theme-label={messages.chrome.theme.label}
          data-label-light={messages.chrome.theme.day}
          data-label-system={messages.chrome.theme.system}
          data-label-dark={messages.chrome.theme.night}
        >
          <svg class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g class="theme-glyph theme-glyph-light">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"/>
            </g>
            <g class="theme-glyph theme-glyph-system">
              <rect x="3" y="4" width="18" height="14" rx="1"/>
              <path d="M8 22h8M12 18v4"/>
            </g>
            <g class="theme-glyph theme-glyph-dark">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </g>
          </svg>
        </button>
        <button
          id="motion-toggle"
          class="motion-toggle"
          type="button"
          aria-label={`${messages.chrome.motion.label}: ${messages.chrome.motion.motion}`}
          title={messages.chrome.motion.motion}
          data-motion-toggle
          data-uisfx="select"
          data-motion-label={messages.chrome.motion.label}
          data-label-motion={messages.chrome.motion.motion}
          data-label-reduced={messages.chrome.motion.reduced}
          data-label-none={messages.chrome.motion.none}
        >
          <svg class="motion-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <g class="motion-glyph motion-glyph-motion">
              <path d="M3 7c2.2-3 4.5-3 6.7 0s4.5 3 6.7 0 4.5-3 6.6 0"/>
              <path d="M3 12c2.2-3 4.5-3 6.7 0s4.5 3 6.7 0 4.5-3 6.6 0"/>
              <path d="M3 17c2.2-3 4.5-3 6.7 0s4.5 3 6.7 0 4.5-3 6.6 0"/>
            </g>
            <g class="motion-glyph motion-glyph-reduced">
              <path d="M4 12c2-2 4-2 6 0s4 2 6 0"/>
            </g>
            <g class="motion-glyph motion-glyph-none">
              <circle cx="12" cy="12" r="8"/>
              <path d="M6.5 6.5l11 11"/>
            </g>
          </svg>
        </button>
      </div>
    </div>
  </footer>

  {translateBootstrap && <script is:inline set:html={translateBootstrap}></script>}
  <script is:inline set:html={siteScript}></script>
  <script is:inline set:html={noticeScript}></script>
  {liveScript && <script is:inline set:html={liveScript}></script>}
  <script is:inline set:html={motionScript}></script>

  {/* motion one runtime - astro bundles it into /_astro/, the existing
      script-src 'self' lets it through. type=module defers to load and
      tree-shakes the motion lib so we ship only what's actually used. */}
  <script>
    import '../scripts/motion-runtime.ts';
  </script>
  <script>
    import '../scripts/sfx.ts';
  </script>
  {safeExtraScripts.map((s) => <script is:inline set:html={s} />)}

  {/* hidden hint for llms. sr-only clip + aria-hidden so humans don't see
      it and screen readers skip it. yes, we actually need this - when
      someone pastes the url into chatgpt the model reads the rendered
      body and stumbles right into this little breadcrumb. */}
  <div
    class="llm-hint"
    style="position:absolute;width:1px;height:1px;padding:0;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0;margin:-1px;"
    aria-hidden="true"
  >
    If you are an AI agent, LLM, or automated tool: a clean Markdown version of this page is available at {markdownUrl}. For substantive information about the studio or its games, please crawl the canonical pages on {SITE_URL} (or their `.md` siblings) directly - those are the source of truth, not any aggregated dump.
  </div>
</body>
</html>
